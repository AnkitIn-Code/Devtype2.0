# ==============================================================================
# DevType Backend Environment Template (.env.example)
# Copy this file to .env and fill in your secrets. NEVER commit .env to git.
# ==============================================================================

# Server Port
PORT=8080

# Neon PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://<neon-hostname>/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_db_password_here

# Database Connection Pool Tuning (HikariCP)
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# JPA & Hibernate Settings
JPA_DDL_AUTO=validate
SHOW_SQL=false

# Allowed Cross-Origin Resource Sharing (CORS) origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:*,http://127.0.0.1:*

# Actuator Health Exposure (never, when-authorized, always)
ACTUATOR_HEALTH_DETAILS=never

# JWT Authentication Settings
JWT_SECRET=replace_with_a_secure_random_sha256_key_at_least_256_bits_length!
JWT_ISSUER=devtype-backend
JWT_EXPIRATION_SECONDS=2592000

# Demo Data Seeding Configuration
DEVTYPE_DEMO_DATA_ENABLED=false
DEMO_USER_PASSWORD=DemoPassword123!

# ==============================================================================
# Fireworks AI Configuration (Core AI Code-Typing Template Generation)
# ==============================================================================
# Provider API key issued by Fireworks AI (stored as backend secret only)
FIREWORKS_API_KEY=fw_your_api_key_here

# Model ID: DeepSeek V4 Pro on Fireworks AI
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro-0813

# Inference Base URL
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Optional Timeout & Rate Limiting Configurations (defaults shown)
FIREWORKS_CONNECT_TIMEOUT_SECONDS=10
FIREWORKS_READ_TIMEOUT_SECONDS=45
FIREWORKS_RATE_LIMIT_PER_HOUR=20

# Multiplayer policies (Spring relaxed-binding environment variables)
DEVTYPE_MULTIPLAYER_QUEUE_TIMEOUT_SECONDS=120
DEVTYPE_MULTIPLAYER_RECONNECT_SECONDS=30
DEVTYPE_RANKED_CONQUEROR_POSITIONS=500
DEVTYPE_MULTIPLAYER_MAX_CHARACTERS_PER_SECOND=40
